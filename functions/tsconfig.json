{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": { "@tms/shared": ["../packages/shared/src/index.ts"] }
  },
  "include": ["src/**/*.ts", "../packages/shared/src/**/*.ts"]
}
